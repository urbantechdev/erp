{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Liquor/Beverage product entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "sku", "name"]
    },
    "Branch": {
      "title": "Branch",
      "description": "ERP Branch entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "code", "name"]
    },
    "WebsiteDeliveryOrder": {
      "title": "WebsiteDeliveryOrder",
      "description": "Website delivery order entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "branchId": { "type": "string" }
      },
      "required": ["id", "orderNumber", "branchId"]
    },
    "SaleOrder": {
      "title": "SaleOrder",
      "description": "Sale order entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "branchId": { "type": "string" }
      },
      "required": ["id", "orderNumber", "branchId"]
    },
    "ApprovalRequest": {
      "title": "ApprovalRequest",
      "description": "Request for approval on critical functionality",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "targetId": { "type": "string" },
        "requesterId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "targetId", "requesterId", "status", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "products": { "schema": "Product", "description": "Products collection" },
    "branches": { "schema": "Branch", "description": "Branches collection" },
    "website_delivery_orders": { "schema": "WebsiteDeliveryOrder", "description": "Website orders collection" },
    "sale_orders": { "schema": "SaleOrder", "description": "Sale orders collection" },
    "approval_requests": { "schema": "ApprovalRequest", "description": "Approval requests collection" },
    "admins": { "schema": "Admin", "description": "Admins collection" }
  }
