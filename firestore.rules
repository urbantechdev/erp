rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Global catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins
    match /admins/{userId} {
      allow read: if isAdmin();
    }

    // Approval Requests
    match /approval_requests/{requestId} {
      allow create: if isSignedIn() && incoming().requesterId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.requesterId == request.auth.uid || isAdmin());
      allow update: if isAdmin() && incoming().status in ['APPROVED', 'REJECTED'];
    }
  }
}
